# Discovery only. Replay never calls a model.
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
DEX_MODEL=openai/gpt-oss-20b

# Provider rate limiting, enforced inside the client.
DEX_RATE_LIMIT_PER_MIN=49
DEX_MIN_REQUEST_SPACING_MS=1300

DEX_TARGET_PORT=8080
DEX_OPERATOR_PORT=4000

# Demo credentials for the synthetic target app.
DEX_ESCALATION_TIMEOUT_MS=900000
DEX_TELLER_USER=admin
DEX_TELLER_PASS=admin
