      "name": "memberId",
      "type": "string",
      "required": true,
      "description": "Six-digit member number.",
      "sensitivity": "pii",
      "pattern": "^\\d{6}$",
      "example": "100001"
    },
    {
      "name": "nickname",
      "type": "string",
      "required": true,
      "description": "Display name for the new sub-account.",
      "sensitivity": "internal",
      "example": "Vacation Fund"
    },
    {
      "name": "initialDeposit",
      "type": "number",
      "required": true,
      "description": "Opening deposit in USD. Must be at least 25.",
      "sensitivity": "internal",
      "example": "50"
    }
  ],
  "outputs": [
